# NOOR SOCIAL OS — environment variables
#
# Names only. Copy to .env.local (development) or set in your host's
# environment (production). Never commit real values. Server-only variables
# are read at runtime; NEXT_PUBLIC_* values are safe to expose to browsers.

# --- App ----------------------------------------------------------------------
# Public base URL, e.g. https://app.example.com (used for links, OAuth
# callbacks, Stripe return URLs, and Secure cookies when https).
NEXT_PUBLIC_APP_URL=

# --- Supabase (Auth + Storage) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Auth admin (suspensions) and signed Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for media (default: media).
SUPABASE_STORAGE_BUCKET=

# --- Database (server only) ---------------------------------------------------
# Supabase transaction pooler connection string (port 6543).
DATABASE_URL=
# Pool size per server instance (default 5).
DATABASE_POOL_MAX=
# disable | require | no-verify (default disable; use require in production).
# TLS parameters in DATABASE_URL (sslmode …) are ignored; this setting decides.
DATABASE_SSL=
# PEM of the database's root CA, trusted alongside the system CAs when
# DATABASE_SSL=require. Supabase: Database Settings → SSL Configuration.
DATABASE_SSL_CA=

# --- Security (server only) ---------------------------------------------------
# Comma-separated key ring for encrypting platform tokens: id:base64(32 bytes).
# Generate a key: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=
# Which key id encrypts new tokens (older ids still decrypt).
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
# HMAC secret for hashing IP addresses in rate limits and audit logs.
IP_HASH_SECRET=
# Bearer secret for POST /api/cron/publishing.
CRON_SECRET=
# Scales every rate limit (1–1000, default 1). Only raise for load tests.
RATE_LIMIT_MULTIPLIER=

# --- AI assistant (server only) -----------------------------------------------
# auto (default: Anthropic when a key is set, otherwise labelled demo
# templates) | anthropic (require the key) | demo (never call a model).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Model id (default claude-opus-5-5).
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max (default medium).
ANTHROPIC_EFFORT=

# --- Billing (server only) ----------------------------------------------------
# none (default) | stripe
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe recurring price ids for each paid plan.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- Demo mode ----------------------------------------------------------------
# true (default) | false. Demo workspaces hold only simulated data.
DEMO_MODE_ENABLED=

# --- Social platform integrations (server only) -------------------------------
# Adapters are not implemented yet (see docs/INTEGRATIONS.md); these only
# switch the admin panel's "credentials present" indicator.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Worker -------------------------------------------------------------------
# Poll interval for `pnpm worker` in milliseconds (default 15000).
WORKER_POLL_INTERVAL_MS=

# --- Development only ---------------------------------------------------------
# Serve /styleguide in production builds (default off).
ENABLE_STYLEGUIDE=
