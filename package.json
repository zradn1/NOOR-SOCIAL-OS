{
  "name": "noor-social-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:reset": "tsx tooling/local-db/apply.ts reset",
    "db:migrate": "tsx tooling/local-db/apply.ts migrate",
    "db:types": "LOCAL_DB_NAME=noor_codegen tsx tooling/local-db/apply.ts reset && kysely-codegen --url postgresql://postgres:postgres@127.0.0.1:5432/noor_codegen --dialect postgres --date-parser string --include-pattern 'public.*' --out-file src/server/db/schema.generated.ts && prettier --write src/server/db/schema.generated.ts 2>/dev/null || true",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "admin:grant": "tsx --conditions=react-server scripts/grant-platform-admin.ts",
    "auth:emulator": "tsx tooling/auth-emulator/server.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "geist": "^1.8.2",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jose": "^6.2.13",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
